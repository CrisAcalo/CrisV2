{
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "scripts": {
    "dev": "nodemon -r dotenv/config src/index.ts",
    "prebuild": "node scripts/install-render-dependencies.cjs",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test:integration": "npm run build && node --test tests/api.integration.cjs",
    "test:security": "npm run build && node --test tests/security.api.cjs",
    "admin:rotate-password": "ts-node scripts/rotate-admin-password.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1"
    },
    "nodemon": {
      "minimatch": "11.0.9"
    }
  }
}
