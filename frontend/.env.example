# Local API: http://localhost:4000/api
# In Netlify, set this to the public Render URL ending in /api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Optional server-only URL for the administrative gateway. Defaults to NEXT_PUBLIC_API_URL.
# PORTFOLIO_API_URL=http://localhost:4000/api
# Public site origin used for social previews.
NEXT_PUBLIC_SITE_URL=https://cristianacalo.netlify.app
# Optional override for dashboard writes if the deployed admin origin differs.
# ADMIN_SITE_ORIGIN=https://cristianacalo.netlify.app
# Optional: comma-separated HTTPS image hosts for responsive project images.
# NEXT_PUBLIC_PROJECT_IMAGE_HOSTS=images.unsplash.com
