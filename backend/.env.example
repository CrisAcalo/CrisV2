# Local Docker development. Replace every placeholder with a unique value.
DATABASE_URL=postgresql://cris:REPLACE_WITH_LOCAL_DB_PASSWORD@localhost:5432/crisv2?schema=public

# Browser origins, without trailing slashes. Server-to-server requests do not need Origin.
# ALLOWED_ORIGINS=https://crisacalo.com,https://www.crisacalo.com,http://localhost:3005
# TRUST_PROXY_HOPS=0
# PUBLIC_SITE_ORIGIN=https://crisacalo.com
# CONTACT_EMAIL_DAILY_LIMIT=80
LOCAL_DB_PASSWORD=REPLACE_WITH_LOCAL_DB_PASSWORD
LOCAL_PGADMIN_PASSWORD=REPLACE_WITH_LOCAL_PGADMIN_PASSWORD

# Absolute session lifetime. Default: 30 (allowed: 5 to 720 minutes).
# AUTH_SESSION_TTL_MINUTES=30
# Optional TOTP enrollments using distinct, random 32-character Base32 keys.
# ADMIN_MFA_SECRETS={"admin@example.test":"REPLACE_WITH_A_RANDOM_BASE32_SECRET"}
# Set true after enrolling every active administrator.
# ADMIN_MFA_REQUIRED=false

# The demo seed resets all local content. It is blocked in production.
CONFIRM_DESTRUCTIVE_SEED=yes
SEED_ADMIN_EMAIL=local-admin@example.test
SEED_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Optional integrations. Configure these only where used.
# LINKEDIN_API_TOKEN=

# Contact notifications via Resend HTTPS. Set all three to enable them.
# RESEND_API_KEY=REPLACE_WITH_RESEND_SENDING_KEY
# RESEND_FROM=contacto@crisacalo.com
# MAIL_TO=owner@example.com
